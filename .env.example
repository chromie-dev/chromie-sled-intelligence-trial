# Copy to .env and fill in. .env is gitignored and must stay that way.
# Never add Chromie or customer credentials.

# Browserbase — the API key alone resolves the project; there is no project-id variable.
BROWSERBASE_API_KEY=

# Procurement portal accounts. Prefer self-registered accounts over supplied ones.
PLANETBIDS=
PLANET_BIDS_PASSWORD=
CALEPROCURE_USERNAME=
CALEPROCURE_PASSWORD=
